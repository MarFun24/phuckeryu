    {
      "id": "064c8c7a-17f2-4b2e-b9fe-5dbc2067cafe",
      "name": "Shipping Confirmation to Buyer",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        220,
        -160
      ],
      "webhookId": "6b09db91-f28a-48dd-94f8-d1e3f014b6e7",
      "notes": "Deliberately has NO attachment - the buyer is paying for the physical object.",
      "credentials": {
        "gmailOAuth2": {
          "id": "RLBTrfrjF2rL8iqY",
          "name": "Phuckery Email"
        }
      },
      "parameters": {
        "sendTo": "={{ $('Order Webhook').item.json.body.email }}",
        "subject": "Your Degree Has Entered Physical Production",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Order Confirmed</title></head>\n<body style=\"margin:0;padding:0;background-color:#f4f4f4;font-family:Georgia,serif;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#f4f4f4;\">\n<tr><td align=\"center\" style=\"padding:20px 0;\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 6px rgba(0,0,0,0.1);\">\n<tr><td align=\"center\" style=\"background:#01538B;background:linear-gradient(135deg,#01538B 0%,#023a61 100%);padding:40px 30px;\">\n<h1 style=\"color:#ffffff;margin:0;font-size:28px;line-height:1.2;\">University of Phuckery</h1>\n<p style=\"color:#93c5fd;margin:8px 0 0;font-size:16px;letter-spacing:1px;\">Office of Distinguished Nonsense</p>\n</td></tr>\n<tr><td style=\"padding:40px 30px;color:#374151;font-size:16px;line-height:1.6;\">\n<p style=\"margin:0 0 20px;\">Congratulations are in order, and this time they come with postage.</p>\n<p style=\"margin:0 0 20px;\">The Office of Distinguished Nonsense confirms that your order has been received, your payment has cleared, and the following degree has been referred to our Department of Physical Manufacture:</p>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:0 0 24px;\">\n<tr><td style=\"padding:20px;background:#f9fafb;border-left:4px solid #01538B;border-radius:4px;\">\n<p style=\"margin:0 0 6px;font-size:18px;font-weight:bold;color:#01538B;\">{{ $('Order Webhook').item.json.body.degreeLevel }}</p>\n<p style=\"margin:0 0 6px;font-size:16px;color:#374151;\">Conferred upon <strong>{{ $('Order Webhook').item.json.body.firstName }} {{ $('Order Webhook').item.json.body.lastName }}</strong></p>\n<p style=\"margin:0;font-size:14px;color:#6b7280;\">{{ $('Order Webhook').item.json.body.faculty }}</p>\n</td></tr>\n</table>\n<p style=\"margin:0 0 20px;\">Your certificate is now being printed on heavy parchment stock, pressed with a gold embossed PhuckeryU seal, wrapped in tissue paper, sealed again (we are thorough), and laid to rest in a regal navy display folder. It measures 8.5&quot; by 11&quot;, which is to say it is sized for framing by anyone with the courage to hang it.</p>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:0 0 24px;\">\n<tr><td style=\"padding:16px 20px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;\">\n<p style=\"margin:0;font-size:15px;color:#1e3a5f;\"><strong>Please allow 1&ndash;2 weeks for delivery.</strong> Real objects move at the speed of the postal service, not the internet. Shipping within Canada is included in what you have already paid; there is nothing further to settle.</p>\n</td></tr>\n</table>\n<p style=\"margin:0 0 20px;\">You will note that nothing is attached to this email. This is deliberate. You have purchased an object, not a file, and the University does not believe in spoiling the reveal.</p>\n<p style=\"margin:0 0 20px;\">We recommend clearing a modest space on a wall, or on a mantel, or wherever you display the things you would like people to ask about.</p>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:30px auto;\">\n<tr><td align=\"center\" style=\"border-radius:8px;background-color:#01538B;\">\n<a href=\"https://www.phuckeryu.com/\" target=\"_blank\" style=\"font-size:16px;font-weight:bold;color:#ffffff;text-decoration:none;padding:15px 25px;display:inline-block;border-radius:8px;border:1px solid #01538B;\">Bestow Another Degree</a>\n</td></tr>\n</table>\n<p style=\"margin:0 0 20px;font-size:15px;\">Should your certificate fail to appear within a fortnight, reply to this email and someone in Fulfilment will be held accountable in a manner of our choosing.</p>\n<p style=\"margin:30px 0 0;\">With institutional pride and very little oversight,</p>\n<p style=\"margin:5px 0 0;font-weight:bold;\">Dean Vlad X &amp; Chancellor Eleni X</p>\n</td></tr>\n<tr><td align=\"center\" style=\"padding:20px 30px;background-color:#f9fafb;border-top:1px solid #e5e7eb;font-size:14px;color:#9ca3af;\">University of Phuckery | Office of Distinguished Nonsense</td></tr>\n</table>\n</td></tr></table></body></html>",
        "options": {
          "appendAttribution": false
        }
      }
    }
  ],
