    {
      "id": "541e2ed7-d035-489d-b618-82efd9fb6f60",
      "name": "Print Order to Helen",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        -20,
        -160
      ],
      "webhookId": "883ee152-6a42-489b-bd23-540c250e419f",
      "notes": "Everything needed to print and ship without replying to ask.",
      "credentials": {
        "gmailOAuth2": {
          "id": "RLBTrfrjF2rL8iqY",
          "name": "Phuckery Email"
        }
      },
      "parameters": {
        "sendTo": "phuckeryu@gmail.com",
        "subject": "=PRINT ORDER: {{ $('Order Webhook').item.json.body.degreeLevel }} for {{ $('Order Webhook').item.json.body.firstName }} {{ $('Order Webhook').item.json.body.lastName }}",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"UTF-8\"><title>Print Order</title></head>\n<body style=\"margin:0;padding:0;background-color:#f4f4f4;font-family:Georgia,serif;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#f4f4f4;\">\n<tr><td align=\"center\" style=\"padding:20px 0;\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 6px rgba(0,0,0,0.1);\">\n<tr><td align=\"center\" style=\"background:#01538B;background:linear-gradient(135deg,#01538B 0%,#023a61 100%);padding:30px;\">\n<h1 style=\"color:#ffffff;margin:0;font-size:24px;line-height:1.2;\">Print Order</h1>\n<p style=\"color:#93c5fd;margin:8px 0 0;font-size:14px;letter-spacing:1px;\">University of Phuckery | Fulfilment</p>\n</td></tr>\n<tr><td style=\"padding:30px;color:#374151;font-size:15px;line-height:1.6;\">\n<p style=\"margin:0 0 24px;\">A printed certificate has been paid for. The print-ready PDF is attached to this email.</p>\n<h2 style=\"font-size:13px;text-transform:uppercase;letter-spacing:1px;color:#01538B;border-bottom:2px solid #e5e7eb;padding-bottom:6px;margin:0 0 12px;\">Print These Details</h2>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"font-size:15px;color:#374151;margin:0 0 28px;\">\n<tr><td width=\"38%\" style=\"padding:6px 0;color:#6b7280;vertical-align:top;\">Name on certificate</td><td style=\"padding:6px 0;font-weight:bold;\">{{ $('Order Webhook').item.json.body.firstName }} {{ $('Order Webhook').item.json.body.lastName }}</td></tr>\n<tr><td style=\"padding:6px 0;color:#6b7280;vertical-align:top;\">Degree level</td><td style=\"padding:6px 0;\">{{ $('Order Webhook').item.json.body.degreeLevel }}</td></tr>\n<tr><td style=\"padding:6px 0;color:#6b7280;vertical-align:top;\">Faculty</td><td style=\"padding:6px 0;\">{{ $('Order Webhook').item.json.body.faculty }}</td></tr>\n<tr><td style=\"padding:6px 0;color:#6b7280;vertical-align:top;\">Achievement</td><td style=\"padding:6px 0;\">{{ $('Order Webhook').item.json.body.achievement }}</td></tr>\n<tr><td style=\"padding:6px 0;color:#6b7280;vertical-align:top;\">Certification date</td><td style=\"padding:6px 0;\">{{ $('Order Webhook').item.json.body.certificationDate }}</td></tr>\n<tr><td style=\"padding:6px 0;color:#6b7280;vertical-align:top;\">Template style</td><td style=\"padding:6px 0;\">{{ $('Order Webhook').item.json.body.style }}</td></tr>\n</table>\n<h2 style=\"font-size:13px;text-transform:uppercase;letter-spacing:1px;color:#01538B;border-bottom:2px solid #e5e7eb;padding-bottom:6px;margin:0 0 12px;\">Ship To</h2>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:0 0 28px;\">\n<tr><td style=\"padding:16px;background:#f9fafb;border-left:4px solid #01538B;border-radius:4px;font-size:16px;line-height:1.7;color:#111827;\">\n<strong>{{ $('Order Webhook').item.json.body.shippingName }}</strong><br>\n{{ $('Order Webhook').item.json.body.shippingLine1 }}<br>\n{{ $('Order Webhook').item.json.body.shippingLine2 ? $('Order Webhook').item.json.body.shippingLine2 + '<br>' : '' }}{{ $('Order Webhook').item.json.body.shippingCity }}, {{ $('Order Webhook').item.json.body.shippingState }} {{ $('Order Webhook').item.json.body.shippingPostalCode }}<br>\n{{ $('Order Webhook').item.json.body.shippingCountry }}<br>\n<span style=\"font-size:14px;color:#6b7280;\">Phone (for the courier): {{ $('Order Webhook').item.json.body.shippingPhone || 'Not provided' }}</span>\n</td></tr>\n</table>\n<h2 style=\"font-size:13px;text-transform:uppercase;letter-spacing:1px;color:#01538B;border-bottom:2px solid #e5e7eb;padding-bottom:6px;margin:0 0 12px;\">Buyer</h2>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"font-size:15px;color:#374151;\">\n<tr><td width=\"38%\" style=\"padding:6px 0;color:#6b7280;vertical-align:top;\">Email</td><td style=\"padding:6px 0;\">{{ $('Order Webhook').item.json.body.email }}</td></tr>\n<tr><td style=\"padding:6px 0;color:#6b7280;vertical-align:top;\">Paid</td><td style=\"padding:6px 0;\">CAD ${{ $('Order Webhook').item.json.body.amountPaid }}</td></tr>\n<tr><td style=\"padding:6px 0;color:#6b7280;vertical-align:top;\">Stripe reference</td><td style=\"padding:6px 0;font-size:13px;color:#6b7280;\">{{ $('Order Webhook').item.json.body.checkoutSessionId || $('Order Webhook').item.json.body.paymentIntentId }}</td></tr>\n</table>\n<p style=\"margin:24px 0 0;font-size:14px;color:#6b7280;\">If the address looks wrong or incomplete, reply straight to the buyer at the email above.</p>\n</td></tr>\n<tr><td align=\"center\" style=\"padding:20px 30px;background-color:#f9fafb;border-top:1px solid #e5e7eb;font-size:13px;color:#9ca3af;\">University of Phuckery | Office of Distinguished Nonsense</td></tr>\n</table>\n</td></tr></table></body></html>",
        "options": {
